rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().status == "active";
    }
    function roleIs(roleName) {
      return activeUser() && userDoc().role == roleName;
    }
    function isAdmin() {
      return roleIs("administrador");
    }
    function isManagement() {
      return isAdmin() || roleIs("direcao") || roleIs("secretaria");
    }
    function assignedTo(classId) {
      return activeUser()
        && exists(/databases/$(database)/documents/teacherAssignments/$(request.auth.uid + "_" + classId))
        && get(/databases/$(database)/documents/teacherAssignments/$(request.auth.uid + "_" + classId)).data.active == true;
    }
    function enrolled(studentId, classId) {
      return exists(/databases/$(database)/documents/enrollments/$(studentId + "_" + classId))
        && get(/databases/$(database)/documents/enrollments/$(studentId + "_" + classId)).data.active == true;
    }
    function isOwnStudent(studentId) {
      return activeUser() && roleIs("estudante") && userDoc().studentId == studentId;
    }
    function isGuardianOf(studentId) {
      return activeUser()
        && roleIs("responsavel")
        && exists(/databases/$(database)/documents/guardianships/$(request.auth.uid + "_" + studentId))
        && get(/databases/$(database)/documents/guardianships/$(request.auth.uid + "_" + studentId)).data.active == true;
    }
    function canSeeStudent(studentId) {
      return isManagement() || isOwnStudent(studentId) || isGuardianOf(studentId);
    }

    // O primeiro administrador deve ser provisionado manualmente e com segurança
    // no Console Firebase. Cadastro público nunca pode escolher perfis administrativos.
    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ["estudante", "responsavel", "professor"]
        && request.resource.data.status == "pending";
      allow read: if signedIn() && (request.auth.uid == uid || isManagement());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photoURL"]));
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isManagement() || assignedTo(classId);
      allow create, update, delete: if isManagement();
    }

    match /students/{studentId} {
      allow read: if canSeeStudent(studentId)
        || (activeUser() && roleIs("professor")
          && exists(/databases/$(database)/documents/enrollments/$(studentId + "_" + resource.data.classId))
          && assignedTo(resource.data.classId));
      allow create, update, delete: if isManagement();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isManagement()
        || (activeUser() && roleIs("professor") && assignedTo(resource.data.classId))
        || canSeeStudent(resource.data.studentId);
      allow create, update, delete: if isManagement();
    }

    match /teacherAssignments/{assignmentId} {
      allow read: if isManagement()
        || (activeUser() && resource.data.teacherUid == request.auth.uid);
      allow create, update, delete: if isManagement();
    }

    match /guardianships/{relationshipId} {
      allow read: if isManagement()
        || (activeUser() && resource.data.guardianUid == request.auth.uid);
      allow create, update, delete: if isManagement();
    }

    match /attendance/{attendanceId} {
      allow read: if isManagement()
        || (activeUser() && roleIs("professor") && assignedTo(resource.data.classId))
        || canSeeStudent(resource.data.studentId);
      allow create: if activeUser()
        && (isManagement()
          || (roleIs("professor")
            && assignedTo(request.resource.data.classId)
            && enrolled(request.resource.data.studentId, request.resource.data.classId)
            && request.resource.data.teacherUid == request.auth.uid));
      allow update: if isManagement()
        || (activeUser() && roleIs("professor")
          && assignedTo(resource.data.classId)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isManagement();
    }

    match /authorizations/{authorizationId} {
      allow read: if isManagement()
        || canSeeStudent(resource.data.studentId)
        || (activeUser() && roleIs("professor") && assignedTo(resource.data.classId));
      allow create: if activeUser()
        && (isManagement() || isGuardianOf(request.resource.data.studentId));
      allow update, delete: if isManagement();
    }

    match /trips/{tripId} {
      allow read: if activeUser();
      allow create, update, delete: if isManagement();
    }

    match /reports/{reportId} {
      allow read, write: if isManagement();
    }

    // Qualquer coleção não prevista permanece bloqueada por padrão.
  }
}
