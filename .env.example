# Copie para .env e preencha localmente. Nunca envie o .env ao GitHub.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/sgve.sqlite
ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=admin@escola.local
# Firebase Admin SDK: mantenha a chave privada apenas no ambiente seguro do servidor.
FIREBASE_PROJECT_ID=svge-14ec7
# Cole o JSON completo da conta de serviço somente no ambiente local/Render, nunca aqui.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Defina localmente uma senha forte com pelo menos 14 caracteres.
ADMIN_PASSWORD=